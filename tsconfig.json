{
 "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "es2017"],
    "target": "es5",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@pages/*": ["src/pages/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": [
    "src/pages/*",
    "src/components/*",
    "src/layouts/*",
    "src/utils/*",
    "astro.config.*"
  ],
  "exclude": ["node_modules"]
}