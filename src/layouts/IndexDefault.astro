---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en" class="dark">
<head>
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <!-- Menambahkan tag link untuk favicon -->
  <link rel="icon" type="image/x-icon" href="/assets/images/favicon.svg" />
  <!-- Add the ViewTransitions component for smooth page transitions -->
  <ViewTransitions />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;800&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body class=home-page bg-zinc-950 text-zinc-200 font-inter>
  <slot />
</body>
</html>