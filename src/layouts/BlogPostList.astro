---
import "../styles/global.css";
import { getCollection } from "astro:content";
import SidebarCategories from "../components/SidebarCategories";

// Ambil & urutkan data post
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<!-- Layout Body -->
  <main class="grid grid-cols-1 md:grid-cols-4 gap-8 max-w-6xl mx-auto px-4 py-12">
    <!-- Sidebar -->
    <div class="md:col-span-1">
      <SidebarCategories client:load />
    </div>

    <!-- Blog Posts -->
    <section class="md:col-span-3 space-y-8">
      {
        posts.map((post) => (
          <article class="bg-zinc-900 border border-yellow-700 shadow-md shadow-yellow-300/10 rounded-lg p-4 transition-transform duration-300 hover:scale-[1.01] hover:shadow-yellow-300/20 hover:border-yellow-500">
            <a href={`/blog/${post.slug}`} class="block group">
              <h2 class="text-xl font-bold text-yellow-500 group-hover:underline">
                {post.data.title}
              </h2>
              <p class="text-xs text-yellow-200 mb-1">
                {new Date(post.data.pubDate).toLocaleDateString("id-ID", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <p class="text-sm text-gray-200 mb-2">{post.data.description}</p>

              {post.data.author && (
                <div class="flex items-center gap-2 mt-2">
                  <img
                    src={post.data.author.image}
                    alt={post.data.author.name}
                    class="w-6 h-6 rounded-full border border-yellow-700"
                  />
                  <span class="text-xs text-gray-400">{post.data.author.name}</span>
                </div>
              )}
            </a>
          </article>
        ))
      }
    </section>
  </main>

