---
import { getCollection } from "astro:content";

const POSTS_PER_PAGE = 10;
const url = new URL(Astro.request.url);
const categoryFilter = url.searchParams.get("category")?.toLowerCase() || null;

let allPosts = await getCollection("blog");
allPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const filteredPosts = categoryFilter
  ? allPosts.filter(
      (post) => post.data.category?.toLowerCase() === categoryFilter
    )
  : allPosts;

const posts = filteredPosts.slice(0, POSTS_PER_PAGE).map((p) => ({
  title: p.data.title,
  slug: p.slug,
  description: p.data.description,
  pubDate: p.data.pubDate,
  category: p.data.category,
  image: p.data.image ?? null,
}));

---
  <section class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    {
      posts.length === 0 ? (
        <p class="text-zinc-400 col-span-full text-center mt-10">
          No articles found for this category. 😥
        </p>
      ) : (
        posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group block bg-zinc-900 border border-yellow-700/50 rounded-xl shadow-lg transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:border-yellow-400/80 hover:bg-zinc-800"
            aria-label={`Baca artikel ${post.title}`}
          >
            {post.image ? (
              <div class="h-40 w-full overflow-hidden rounded-t-xl bg-zinc-800 flex items-center justify-center">
                <img
                  src={post.image}
                  alt={post.title}
                  class="max-h-full max-w-full object-cover transition-transform duration-300 group-hover:scale-110"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="h-40 w-full bg-zinc-800 flex items-center justify-center rounded-t-xl text-zinc-500 text-sm">
                No Images
              </div>
            )}

            <div class="p-4 flex flex-col justify-between h-44">
              <div>
                <h2 class="text-lg font-cinzel font-bold text-yellow-400 mb-2 line-clamp-2">
                  {post.title}
                </h2>
                <p class="text-sm text-zinc-300 mb-3 line-clamp-3">
                  {post.description}
                </p>
              </div>
              <div class="flex justify-between items-center text-xs text-zinc-400 mt-auto">
                <time datetime={post.pubDate.toISOString()}>
                  {post.pubDate.toLocaleDateString("id-ID", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <span class="px-2 py-1 bg-yellow-700/30 text-yellow-300 rounded-full text-xs font-cinzel font-semibold">
                  {post.category}
                </span>
              </div>
            </div>
          </a>
        ))
      )
    }
  </section>