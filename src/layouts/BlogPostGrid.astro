---
import { getCollection } from "astro:content";

const POSTS_PER_PAGE = 10;
const url = new URL(Astro.request.url);
const categoryFilter = url.searchParams.get("category")?.toLowerCase() || null;

let allPosts = await getCollection("blog");
allPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const filteredPosts = categoryFilter
  ? allPosts.filter(
      (post) => post.data.category?.toLowerCase() === categoryFilter
    )
  : allPosts;

const posts = filteredPosts.slice(0, POSTS_PER_PAGE).map((p) => ({
  title: p.data.title,
  slug: p.slug,
  description: p.data.description,
  pubDate: p.data.pubDate,
  category: p.data.category,
  image: p.data.image ?? null,
}));

---
  <section class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      posts.length === 0 ? (
        <p class="text-gray-400 col-span-full text-center mt-10">
          Artikel tidak ditemukan untuk kategori ini.
        </p>
      ) : (
        posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group block bg-zinc-900 border border-yellow-700/50 rounded-md shadow-sm hover:shadow-md transform hover:scale-[1.02] transition duration-200 ease-in-out overflow-hidden"
            aria-label={`Baca artikel ${post.title}`}
          >
            {post.image ? (
              <div class="h-36 w-full overflow-hidden rounded-t-md bg-zinc-800 flex items-center justify-center">
                <img
                  src={post.image}
                  alt={post.title}
                  class="max-h-full max-w-full object-contain transition-transform duration-200 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="h-36 w-full bg-zinc-800 flex items-center justify-center rounded-t-md text-gray-500 text-xs">
                No image available
              </div>
            )}

            <div class="p-3 flex flex-col justify-between h-44">
              <h2 class="text-base font-semibold text-yellow-400 mb-1 line-clamp-2">
                {post.title}
              </h2>
              <p class="text-sm text-gray-300 mb-3 line-clamp-3">
                {post.description}
              </p>
              <div class="flex justify-between items-center text-xs text-gray-400">
                <time datetime={post.pubDate.toISOString()}>
                  {post.pubDate.toLocaleDateString("id-ID", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                <span class="px-1.5 py-0.5 bg-yellow-700/25 text-yellow-300 rounded-full tracking-wide font-semibold text-xs">
                  {post.category}
                </span>
              </div>
            </div>
          </a>
        ))
      )
    }
  </section>

