---
import "../styles/global.css";
import DefaultLayout from "../layouts/Default.astro";
import { HeaderSection } from "../sections/Header";
import { FooterSection } from "../sections/Footer";
import SubnetCalculator from "../components/SubnetCalculator";
import BandwidthConverter from "../components/BandwidthConverter";
---

<DefaultLayout title="Tools - HomeLabs">
  <HeaderSection client:load />

  <main
    class="main-content-style min-h-screen p-6 md:p-12 transition-colors duration-500"
  >
    <div class="max-w-5xl mx-auto space-y-12 animate-fade-in">
      <div class="text-center space-y-4 animate-fade-in-up">
        <h1
          class="hero-title uppercase tracking-widest font-cinzel leading-tight transition-colors duration-500"
        >
          Networking Tools
        </h1>
        <p
          class="text-xl font-light font-cinzel transition-colors duration-500"
        >
          A collection of tools created to simplify tasks and development.
        </p>
      </div>

      <section class="grid md:grid-cols-2 gap-8">
        <div
          class="tool-card animate-slide-in-left"
          style={{
            boxShadow: "0 0 10px var(--shadow-color)",
          }}
        >
          <SubnetCalculator client:load />
        </div>

        <div
          class="tool-card animate-slide-in-right"
          style={{
            boxShadow: "0 0 10px var(--shadow-color)",
          }}
        >
          <BandwidthConverter client:load />
        </div>
      </section>
    </div>
  </main>
  <FooterSection client:load />
</DefaultLayout>

<style>
  /* Gaya untuk main content dan card. Pindahkan ke global.css jika diperlukan. */

  .tool-card {
    position: relative;
    padding: 2rem; /* p-8 di Tailwind */
    border-radius: 1.5rem; /* rounded-3xl di Tailwind */
    background-color: var(--footer-bg);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .tool-card:hover {
    transform: scale(1.01);
  }
</style>
