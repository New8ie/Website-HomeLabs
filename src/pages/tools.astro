---
import "../styles/global.css";
import DefaultLayout from "../layouts/Default.astro";
import { HeaderSection } from "../sections/Header";
import { FooterSection } from "../sections/Footer";
---

<DefaultLayout title="Tools - HomeLabs">
 <HeaderSection client:load />
   <!-- Main Content -->
    <main class="flex-grow flex flex-col justify-center items-center text-center px-4">
      <h1
        class="text-4xl md:max-w-lg font-cinzel font-extrabold text-yellow-300 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)"
        style={{ textShadow: "0 0 10px gold" }}
      >
        Halaman Sedang Dalam Tahap Pengembangan
      </h1>
      <p class="max-w-lg text-yellow-300 text-lg md:text-xl mb-8">
        Kami sedang membangun sesuatu yang keren! Mohon bersabar dan cek kembali nanti.
      </p>
      <img
        src="/assets/images/Logo/leviathan.png"
        alt="Under Construction"
        class="w-48 md:w-64 drop-shadow-lg"
      />
    </main>
  <FooterSection />
</DefaultLayout>