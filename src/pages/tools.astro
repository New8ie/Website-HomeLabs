---
import "../styles/global.css";
import DefaultLayout from "../layouts/Default.astro";
import { HeaderSection } from "../sections/Header";
import { FooterSection } from "../sections/Footer";
import SubnetCalculator from "../components/SubnetCalculator";
import BandwidthConverter from "../components/BandwidthConverter";
---

<DefaultLayout title="Tools - HomeLabs">
  <HeaderSection client:load />

  <!-- Menggunakan variabel CSS untuk latar belakang, warna teks, dan transisi -->
  <main
    class="min-h-screen p-6 md:p-12 transition-colors duration-500"
    style={{
      backgroundColor: "var(--background-color)",
      color: "var(--text-color)",
    }}
  >
     <img
      src="/assets/images/BG/gm-island.jpg"  
      alt="Under Construction"
      class="absolute inset-0 w-full h-full object-cover z-0"
    />
    <div class="max-w-5xl mx-auto space-y-12 animate-fade-in">
      <!-- Title Section -->
      <div class="text-center space-y-4 animate-fade-in-up">
        <!-- Menggunakan variabel CSS untuk warna teks judul -->
        <h1
          class="hero-title uppercase tracking-widest leading-tight transition-colors duration-500"
          style={{ color: "var(--title-color)" }}
        >
          Networking Tools
        </h1>
        <!-- Menggunakan variabel CSS untuk warna teks paragraf -->
        <p
          class="text-xl font-light font-cinzel transition-colors duration-500"
          style={{ color: "var(--text-color)" }}
        >
          A collection of tools created to simplify tasks and development.
        </p>
      </div>

      <!-- Tools Grid -->
      <section class="grid md:grid-cols-2 gap-8">
        <!-- Subnet Calculator Card dengan animasi slide-in dari kiri -->
        <div
          class="relative p-8 rounded-3xl shadow-xl transform transition-all duration-200 hover:scale-[1.01] animate-slide-in-left"
          style={{
            backgroundColor: "var(--footer-bg)",
            borderColor: "var(--border-bg)",
            borderWidth: "1px",
            boxShadow: "0 0 10px var(--shadow-color)",
          }}
        >
          <SubnetCalculator client:load />
        </div>

        <!-- Bandwidth Converter Card dengan animasi slide-in dari kanan -->
        <div
          class="relative p-8 rounded-3xl shadow-xl transform transition-all duration-200 hover:scale-[1.01] animate-slide-in-right"
          style={{
            backgroundColor: "var(--footer-bg)",
            borderColor: "var(--border-bg)",
            borderWidth: "1px",
            boxShadow: "0 0 20px var(--shadow-color)",
          }}
        >
          <BandwidthConverter client:load />
        </div>
      </section>
    </div>
  </main>

  <FooterSection client:load />
</DefaultLayout>
