---
import "../styles/global.css";
import DefaultLayout from "../layouts/Default.astro";
import { HeaderSection } from "../sections/Header";
import { FooterSection } from "../sections/Footer";
---

<DefaultLayout title="Tools - HomeLabs">
  <HeaderSection client:load />
  <!-- Main Content -->
  <section class="relative h-screen w-full">
    <img
      src="/assets/images/BG/gm-island.jpg"  
      alt="Under Construction"
      class="absolute inset-0 w-full h-full object-cover z-0"
    />
    <div class="absolute inset-0 bg-black/30 z-10"></div>

    <!-- Konten Hero -->
    <div
      class="relative z-20 flex flex-col items-center justify-center h-full pb-24 px-4 text-center"
    >
      <h1
        class="text-4xl md:text-6xl font-cinzel font-extrabold text-yellow-300 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]"
      >
       Halaman Sedang Dalam Tahap Pengembangan
  </h1>
      <p class="mt-4 max-w-2xl text-zinc-100 text-base md:text-lg leading-relaxed font-cinzel drop-shadow-[0_1px_4px_rgba(0,0,0,0.7)]">
     <span class="italic">Kami sedang membangun sesuatu yang keren! Mohon bersabar dan cek kembali nanti.</span>
      </p>
    </div>
  </section>
  <FooterSection />
</DefaultLayout>
