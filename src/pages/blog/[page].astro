---
import "../../styles/global.css";
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import DefaultLayout from "../../layouts/Default.astro";
import { HeaderSection } from "../../sections/Header";
import { FooterSection } from "../../sections/Footer";
import BlogManager from "../../components/BlogManager";
import { db, PostLikes } from "../../lib/db/db";
import { eq, count } from "drizzle-orm";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  // Mengambil semua postingan dari koleksi "blog"
  const allPosts = await getCollection("blog");
  // Mengurutkan postingan dari yang terbaru ke terlama
  allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  // Membagi semua postingan menjadi beberapa halaman, dengan 9 postingan per halaman
  return paginate(allPosts, { pageSize: 10 });
};

export const prerender = true;

// Mendapatkan data halaman dari props Astro
const { page } = Astro.props as {
  page: Page<CollectionEntry<"blog"> & { likes: number }>;
};

// Menggabungkan data likes ke postingan yang ada di halaman saat ini
const postsWithLikes = await Promise.all(
  page.data.map(async (post) => {
    // Mengambil jumlah likes dari database berdasarkan slug postingan
    const likesCountResult = await db
      .select({ count: count() })
      .from(PostLikes)
      .where(eq(PostLikes.slug, post.slug));
    const likes = likesCountResult[0]?.count ?? 0;
    return { ...post, likes };
  })
);
---

<DefaultLayout title={`Blog Page ${page.currentPage}`}>
  <HeaderSection client:load />
  <div class="px-4 py-8 mx-auto lg:py-16">
    <div class="max-w-7xl mx-auto space-y-12">
      {/* Breadcrumb Navigation */}
      <div class="flex items-center space-x-2 text-zinc-400 font-cinzel">
        <a href="/" class="hover:underline transition-all duration-300">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:underline transition-all duration-300"
          >Blog</a
        >
        <span>/</span>
        <span class="text-white font-cinzel">Page {page.currentPage}</span>
      </div>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-cinzel text-white leading-tight transition-colors duration-500"
      >
        My Blog
      </h1>

      <BlogManager allPosts={postsWithLikes} pageData={page} client:load />
    </div>
  </div>
  <FooterSection client:load />
</DefaultLayout>
