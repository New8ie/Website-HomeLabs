---
import "../../styles/global.css";
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";

import DefaultLayout from "../../layouts/Default.astro";
import { HeaderSection } from "../../sections/Header";
import { FooterSection } from "../../sections/Footer";
import BlogManager from "../../components/BlogManager";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 9 });
};

const { page } = Astro.props as { page: Page<CollectionEntry<"blog">> };

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const newestPost = allPosts[0];
const otherPosts = allPosts.slice(1);
---

<DefaultLayout title={`Blog - Pages ${page.currentPage}`}>
  <HeaderSection client:load />

  <main class="relative py-12 px-4 min-h-[80vh]">
    <div
      class="relative z-10 max-w-4xl mx-auto space-y-12 p-6 rounded-2xl shadow-lg"
      style="background-color: var(--pages-bg);"
    >
      <div class="flex flex-col animate-fade-in-up">
        {/* Tanggal Postingan */}
        <span
          class="text-xs text-zinc-400 font-cinzel mb-1 uppercase tracking-wider"
        >
          {
            new Date(newestPost.data.pubDate).toLocaleDateString("id-ID", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
          }
        </span>

        {/* Judul Postingan */}
        <h1
          class="text-3xl sm:text-4xl lg:text-3xl font-extrabold font-cinzel leading-tight"
          style="color: var(--title-color);"
        >
          {newestPost.data.title}
        </h1>

        {/* Gambar Utama yang Telah Didesain Ulang */}
        <a
          href={`/blog/${newestPost.slug}`}
          class="block my-6 group"
          aria-label={`Baca postingan tentang ${newestPost.data.title}`}
        >
          <div
            class="relative w-full h-64 md:h-96 rounded-xl overflow-hidden shadow-2xl shadow-yellow-900/40 transition-shadow duration-300"
          >
            <img
              src={newestPost.data.image}
              alt={newestPost.data.title}
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            />

            {/* Overlay dengan Teks */}
            <div
              class="absolute inset-0 bg-gradient-to-t from-zinc-950/90 to-transparent flex items-end p-6"
            >
              <div class="space-y-2">
                <h2
                  class="text-xl sm:text-1xl lg:text-2xl font-extrabold text-white font-cinzel transition-all duration-300 transform group-hover:-translate-y-1"
                >
                  {newestPost.data.title}
                </h2>
                <p
                  class="text-sm sm:text-base text-yellow-400 font-cinzel transition-all duration-300 transform group-hover:translate-y-1"
                >
                  {newestPost.data.description}
                </p>
                <div class="flex justify-end mt-4">
                  <span
                    class="text-xs text-yellow-500 font-semibold uppercase tracking-wider transition-all duration-300 transform group-hover:tracking-widest"
                  >
                    Read Now &rarr;
                  </span>
                </div>
              </div>
            </div>
          </div>
        </a>

        {/* Deskripsi & Tombol "Baca Sekarang" */}
        <div
          class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mt-2"
        >
        </div>
      </div>

      <BlogManager allPosts={allPosts} pageData={page} client:load />
    </div>
  </main>

  <FooterSection client:load />
</DefaultLayout>
