---
import "../../styles/global.css";
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import DefaultLayout from "../../layouts/Default.astro";
import { HeaderSection } from "../../sections/Header";
import { FooterSection } from "../../sections/Footer";
import BlogManager from "../../components/BlogManager";
import { db, PostLikes } from "../../lib/db/db";
import { eq, count } from "drizzle-orm";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection("blog");

  // Pilih satu postingan secara acak sebagai "unggulan"
  const randomIndex = Math.floor(Math.random() * allPosts.length);
  const featuredPost = allPosts[randomIndex];

  // Saring postingan unggulan dari daftar semua postingan
  const otherPosts = allPosts.filter((post) => post.slug !== featuredPost.slug);

  // Urutkan sisa postingan berdasarkan tanggal untuk pagination
  otherPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  // Gabungkan postingan unggulan dengan data like-nya
  const likesCountResult = await db
    .select({ count: count() })
    .from(PostLikes)
    .where(eq(PostLikes.slug, featuredPost.slug));
  const featuredPostLikes = likesCountResult[0]?.count ?? 0;
  
  const featuredPostWithLikes = {
    ...featuredPost,
    likes: featuredPostLikes,
  };

  // Buat array baru untuk pagination yang dimulai dengan postingan unggulan,
  // lalu diikuti oleh sisa postingan
  const postsForPagination = [featuredPostWithLikes, ...otherPosts];

  // Gunakan array yang telah diurutkan dan digabungkan untuk pagination
  return paginate(postsForPagination, { pageSize: 9 });
};

export const prerender = true;

const { page } = Astro.props as {
  page: Page<CollectionEntry<"blog"> & { likes: number }>;
};

// Ambil postingan pertama dari data halaman, yang merupakan postingan acak yang kita masukkan
const newestPost = page.data[0];

---

<DefaultLayout title="Blog Page">
  <HeaderSection client:load />
  <div class="px-4 py-8 mx-auto lg:py-16">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="flex items-center space-x-2 text-zinc-400 font-cinzel">
        <a href="/" class="hover:underline transition-all duration-300">Home</a>
        <span>/</span>
        <span class="text-white font-cinzel">Blog</span>
      </div>
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-cinzel text-white  leading-tight transition-colors duration-500"
      >
        My Blog
      </h1>
      {
        newestPost && (
          <div class="relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 transform hover:scale-[1.01] bg-gradient-to-br from-zinc-800 to-zinc-900">
            <a href={`/blog/${newestPost.slug}`} class="group block">
              <div class="relative w-full h-96">
                <img
                  src={
                    newestPost.data.image ||
                    "https://placehold.co/1280x720/18181b/ffffff?text=No+Image"
                  }
                  alt={newestPost.data.title}
                  class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-8 text-white">
                  <span class="text-xs text-yellow-400 font-cinzel mb-1 uppercase tracking-wider">
                    {new Date(newestPost.data.pubDate).toLocaleDateString(
                      "id-ID",
                      {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      }
                    )}
                  </span>
                  <h2
                    class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white font-cinzel leading-tight transition-all duration-300 transform group-hover:-translate-y-1"
                  >
                    {newestPost.data.title}
                  </h2>
                  <p
                    class="text-sm sm:text-base text-yellow-400 font-cinzel transition-all duration-300 transform group-hover:translate-y-1"
                  >
                    {newestPost.data.description}
                  </p>
                  <div class="flex justify-end mt-4">
                    <span
                      class="text-xs text-yellow-500 font-semibold uppercase tracking-wider transition-all duration-300 transform group-hover:tracking-widest"
                    >
                      Start Read &rarr;
                    </span>
                  </div>
                </div>
              </div>
            </a>
          </div>
        )
      }
      <BlogManager allPosts={page.data} pageData={page} client:load />
    </div>
  </div>
  <FooterSection client:load />
</DefaultLayout>