---
import "../../styles/global.css";
import DefaultLayout from "../../layouts/Default.astro";
import { HeaderSection } from "../../sections/Header";
import { FooterSection } from "../../sections/Footer";
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import BlogPage from "../../components/BlogPage";

// Dapatkan semua postingan blog, diurutkan dari yang terbaru
const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> };
---

<DefaultLayout title={`Blog - Halaman ${page.currentPage}`}>
  <HeaderSection client:load />

  <main class="relative py-12 min-h-[80vh] from-zinc-950">
    <div class="relative z-10 max-w-6xl mx-auto px-4">
      <BlogPage allPosts={allPosts} page={page} client:load />
    </div>

  </main>
  <FooterSection />
</DefaultLayout>

