---
import "../../styles/global.css";
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import DefaultLayout from "../../layouts/Default.astro";
import { HeaderSection } from "../../sections/Header";
import { FooterSection } from "../../sections/Footer";
import BlogManager from "../../components/BlogManager";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  // ✅ Perbaikan: Hapus filter 'draft' yang tidak ada di skema
  const posts = await getCollection("blog");
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  // ✅ Kita hanya mem-paginate postingan selain yang terbaru
  const paginatedPosts = posts.slice(1);
  return paginate(paginatedPosts, { pageSize: 9 });
};

// ✅ Perbaikan: Tentukan tipe data `page` secara eksplisit
const { page } = Astro.props as { page: Page<CollectionEntry<"blog">> };

// ✅ Ambil postingan terbaru secara terpisah
const allPosts = await getCollection("blog");
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const newestPost = allPosts[0];

// ✅ Halaman utama (page 1) akan menampilkan postingan terbaru
const isFirstPage = page.currentPage === 1;
---

<DefaultLayout title={`Blog - Halaman ${page.currentPage}`}>
  <HeaderSection client:load />

  <main class="py-12 px-4">
    <div
      class="relative z-10 max-w-7xl mx-auto space-y-12 p-6 rounded-2xl shadow-lg"
      style={{
        backgroundColor: "var(--pages-bg)",
        border: "1px solid var(--border-bg)",
        boxShadow: "0px 4px 20px 0px var(--shadow-color)",
      }}
    >
      {/* Container untuk artikel utama hanya di halaman 1 */}
      {
        isFirstPage && newestPost && (
          <div class="flex flex-col animate-fade-in-up py-3">
            <a
              href={`/blog/${newestPost.slug}`}
              class="group"
              aria-label={`Baca postingan tentang ${newestPost.data.title}`}
            >
              <div class="relative w-full h-96 md:h-[500px] rounded-xl overflow-hidden shadow-2xl shadow-yellow-900/40 transition-shadow duration-300">
                <img
                  src={newestPost.data.image}
                  alt={newestPost.data.title}
                  class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                />
                {/* Overlay dengan Teks */}
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/90 to-transparent flex items-end p-6">
                  <div class="space-y-2">
                    <span class="text-xs text-yellow-400 font-cinzel mb-1 uppercase tracking-wider">
                      {new Date(newestPost.data.pubDate).toLocaleDateString(
                        "id-ID",
                        {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        }
                      )}
                    </span>
                    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white font-cinzel leading-tight transition-all duration-300 transform group-hover:-translate-y-1">
                      {newestPost.data.title}
                    </h2>
                    <p class="text-sm sm:text-base text-yellow-400 font-cinzel transition-all duration-300 transform group-hover:translate-y-1">
                      {newestPost.data.description}
                    </p>
                    <div class="flex justify-end mt-4">
                      <span class="text-xs text-yellow-500 font-semibold uppercase tracking-wider transition-all duration-300 transform group-hover:tracking-widest">
                        Start Read &rarr;
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </div>
        )
      }
      
      {/* ✅ Teruskan data yang di-paginate langsung ke BlogManager */}
      <BlogManager allPosts={page.data} pageData={page} client:load />
    </div>
  </main>

  <FooterSection client:load />
</DefaultLayout>