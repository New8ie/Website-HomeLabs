---
import "./../styles/global.css";
import IndexDefault from "../layouts/IndexDefault.astro";
import { HeaderSection } from "../sections/Header";
import { FooterSection } from "../sections/Footer";
---

<IndexDefault title="Main - HomeLabs">
  <HeaderSection client:load />

  <section class="relative h-screen w-full">
    <div
      class="absolute inset-0 z-10 bg-fixed bg-cover bg-center"
      style="background-image: url('/assets/images/BG/bg-3.jpg');"
    ></div>

    <div
      class="relative z-20 flex h-full items-center justify-start pt-[25vh] px-8 md:px-16 lg:px-24"
    >
      <div
        class="max-w-xl text-left animate-fade-in"
      >
        <h1 class="hero-title">HomeLabs</h1>
        <p
          class="mt-4 text-base md:text-lg justify-start leading-relaxed font-cinzel dark:text-yellow-300 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9) animate-fade-in-up"
          style="color: var(--text-bg-color);"
        >
          Explore technology, AI, open source, and the digital world from the
          comfort of your home lab. Discover new innovations, projects, and
          inspiration every day. <span class="italic text-bold">homelab</span>.
          Discover new innovations, projects, and inspiration every day.
        </p>
        <div class="mt-8 animate-fade-in-up">
          <a href="/blog" class="primary-button"> Explore Blogs </a>
        </div>
      </div>
    </div>
  </section>

  <FooterSection client:load />
</IndexDefault>