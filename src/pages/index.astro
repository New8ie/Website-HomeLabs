---
import "./../styles/global.css";
import DefaultLayout from "../layouts/Default.astro";
import { HeaderSection } from "../sections/Header";
import { FooterSection } from "../sections/Footer";
---

<DefaultLayout title="Main - HomeLabs">
  <HeaderSection client:load />

  <section class="relative h-screen w-full homepage-hero">
    <div
      class="relative z-20 flex flex-col items-center justify-center h-full pb-24 px-4 text-center animate-fade-in"
    >
      <h1 class="hero-title">
        HomeLabs
      </h1>
      <p
        class="mt-4 max-w-2xl text-base md:text-lg justify-center font-extrabold leading-relaxed font-cinzel dark:text-yellow-300 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9) animate-fade-in-up"
        style="color: var(--text-bg-color);"
      >
        Explore technology, AI, open source, and the digital world from the comfort of your home lab. Discover new innovations, projects, and inspiration every day. <span class="italic text-bold">homelab</span>. Discover new innovations, projects, and inspiration every day.
      </p>
      <div class="mt-8 animate-fade-in-up">
        <a
          href="/blog"
          class="primary-button-style"
        >
          Explore Blogs
        </a>
      </div>
    </div>
  </section>

  <FooterSection client:load />
</DefaultLayout>
