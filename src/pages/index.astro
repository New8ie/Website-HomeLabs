---
import "./../styles/global.css";
import DefaultLayout from "../layouts/Default.astro";
import { HeaderSection } from "../sections/Header";
import { FooterSection } from "../sections/Footer";
---

<DefaultLayout title="Project - HomeLabs">
  <HeaderSection client:load />

  <section class="relative h-screen w-full">
    <!-- Gambar Latar -->
    <img
      src="/assets/images/BG/bg-4.jpg"
      alt="Home sweet Home"
      class="absolute inset-0 w-full h-full object-cover z-0"
    />

    <!-- Overlay Gelap Transparan Tipis -->
    <div class="absolute inset-0 bg-black/30 z-10"></div>

    <!-- Konten Hero -->
    <div
      class="relative z-20 flex flex-col items-center justify-center h-full pb-24 px-4 text-center"
    >
      <h1
        class="text-4xl md:text-6xl font-cinzel font-extrabold text-yellow-300 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]"
      >
        HomeLabs
      </h1>
      <p
        class="mt-4 max-w-2xl text-zinc-100 text-base md:text-lg justify-center leading-relaxed font-cinzel drop-shadow-[0_1px_4px_rgba(0,0,0,0.7)]"
      >
       Explore technology, AI, open source, and the digital world from the comfort of your home lab. Discover new innovations, projects, and inspiration every day. <span
          class="italic text-bold">homelab</span
        >. Discover new innovations, projects, and inspiration every day.
      </p>
      <div class="mt-8">
        <a
          href="/blog"
          class="px-6 py-2 bg-yellow-400 text-zinc-900 font-cinzel font-semibold rounded shadow-md hover:bg-yellow-300 transition"
        >
          Explore Blogs
        </a>
      </div>
    </div>
  </section>

  <FooterSection />
</DefaultLayout>
